# ---------------------------------------------------------------------------
# Environment variables — copy this file to `.env.local` and fill in as needed.
# Everything here is OPTIONAL. The portfolio works with none of it set.
# Never commit `.env.local` (it is gitignored) and never expose these in
# client-side code — they are read only by server-side route handlers.
# ---------------------------------------------------------------------------

# Optional. A GitHub personal access token raises the public API rate limit
# from 60 requests/hour (per IP) to 5,000 requests/hour. A token with NO
# scopes (or public_repo only) is enough for reading public repositories.
# Leave blank to use unauthenticated public access.
GITHUB_TOKEN=

# --- Contact form (optional) ------------------------------------------------
# Without these two values the contact form validates input and then tells the
# visitor that email delivery is not configured, offering the GitHub link as an
# alternative. Set both to enable real delivery via Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# The "from" address must be a domain verified in your Resend account.
CONTACT_FROM_EMAIL=
